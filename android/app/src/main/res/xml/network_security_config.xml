<?xml version="1.0" encoding="utf-8"?>
<!-- The Mac is reached over the home Wi-Fi: plain HTTP by its address, or HTTPS with the AndroidDrop certificate
     installed on the phone (a user certificate). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
